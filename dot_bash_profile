# .bash_profile

# Silence macOS's "default interactive shell is now zsh" nag in bash 3.2.
export BASH_SILENCE_DEPRECATION_WARNING=1

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# OpenShift via IBM Research RH proxy (rits-roce)
alias ocp='HTTP_PROXY=http://10.2.32.57:3128 HTTPS_PROXY=http://10.2.32.57:3128 NO_PROXY=localhost,127.0.0.1,10.2.32.57,.svc,.cluster.local oc'
